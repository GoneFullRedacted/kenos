{% extends 'base.html.twig' %}

{% block title %}Administration - Accueil{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('assets/css/AdminHome.css') }}">
{% endblock %}

{% block body %}
    <header class="AdminHeader">
        <img src="{{ asset('assets/images/logo-david-kenos.png') }}" alt="Logo" class="AdminLogo">
        <nav class="AdminNav">
            <a href="#">Accueil</a>
            <a href="#">Déconnexion</a>
            <a href="#">Chocolaterie Nevers</a>
            <div class="AdminAvatar"></div>
        </nav>
    </header>

    <section class="AdminWelcome">
        <h1><span>Bienvenue,</span><br>dans votre administration</h1>
    </section>

    <section class="AdminDashboard">
        <div class="Card">
            <div class="Circle">10</div>
            <h2>UTILISATEURS</h2>
            <p>sont inscrits</p>
            <button class="AdminButton">Gérer les utilisateurs</button>
        </div>

        <div class="Card">
            <div class="Circle">5</div>
            <h2>CATÉGORIES</h2>
            <p>de posts sont disponibles</p>
            <button class="AdminButton">Gérer les catégories</button>
        </div>

        <div class="Card CardLarge">
            <div class="Circle">35</div>
            <h2>ACTUALITÉS</h2>
            <p>sont disponibles</p>
            <ul class="NewsList">
                <li>Le 12/09/2021 – Lorem ipsum dolor sit amet</li>
                <li>Le 12/09/2021 – Lorem ipsum dolor sit amet</li>
                <li>Le 12/09/2021 – Lorem ipsum dolor sit amet</li>
            </ul>
            <button class="AdminButton">Gérer les actualités</button>
        </div>

        <div class="Card">
            <div class="Circle">48</div>
            <h2>POSTS</h2>
            <p>sont disponibles</p>
            <button class="AdminButton">Gérer les posts</button>
        </div>
    </section>

    <footer class="AdminFooter">
        Administration développé par EILEA - 2021
    </footer>
{% endblock %}
